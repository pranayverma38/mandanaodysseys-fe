# Theme direction: ltr | rtl
NEXT_PUBLIC_THEME_DIR=ltr

# Production site URL (used for SEO canonical URLs, sitemap, and Open Graph)
NEXT_PUBLIC_SITE_URL=https://mandanaodysseys.com

# GSAP ScrollSmoother — disabled by default; set to "true" to enable
# NEXT_PUBLIC_ENABLE_SMOOTH_SCROLL=true

# Medusa storefront backend
MEDUSA_BACKEND_URL=https://api.mandanaodysseys.com
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.mandanaodysseys.com
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
MEDUSA_SECRET_KEY=
MEDUSA_JWT_SECRET=

# Admin panel (/admin)
ADMIN_PASSWORD=

# Required for /admin custom itineraries (uses Medusa customer metadata)
MEDUSA_SECRET_KEY=
