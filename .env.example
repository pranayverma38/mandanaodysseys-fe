# Theme direction: ltr | rtl
NEXT_PUBLIC_THEME_DIR=ltr

# Production site URL (used for SEO canonical URLs, sitemap, and Open Graph)
NEXT_PUBLIC_SITE_URL=https://mandanaodysseys.com

# GSAP ScrollSmoother — disabled by default; set to "true" to enable
# NEXT_PUBLIC_ENABLE_SMOOTH_SCROLL=true

# Medusa storefront backend
MEDUSA_BACKEND_URL=https://api.mandanaodysseys.com
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.mandanaodysseys.com
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
MEDUSA_SECRET_KEY=
MEDUSA_JWT_SECRET=
# Optional overrides for tour booking orders (auto-detected from store/regions when omitted)
# MEDUSA_REGION_ID=
# MEDUSA_SALES_CHANNEL_ID=

# Admin panel (/admin)
ADMIN_PASSWORD=

# Stripe checkout
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` or Dashboard → Webhooks
STRIPE_WEBHOOK_SECRET=
# Apple Pay: Stripe uses one universal file for all merchants (no per-account download in Dashboard).
# It is committed at public/.well-known/apple-developer-merchantid-domain-association
# After deploy, verify: https://your-domain/.well-known/apple-developer-merchantid-domain-association
# Optional override: STRIPE_APPLE_PAY_DOMAIN_ASSOCIATION=whsec_c9x7oT559ysIRhqZVOETnUIH0t0mLZz9
