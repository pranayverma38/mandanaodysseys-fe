NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
MEDUSA_SECRET_KEY=
MEDUSA_JWT_SECRET=

# Admin panel (/admin)
ADMIN_PASSWORD=

# Stripe checkout
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
